# ==============================================================================
# AICTE IDEA LAB - KUMARAGURU COLLEGE OF TECHNOLOGY (KCT)
# PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

PORT=5003
NODE_ENV=production
CLIENT_URL=http://localhost:5205,https://idealab.kct.ac.in
SESSION_SECRET=kct_idealab_session_secret_replace_in_production_32chars!

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
# Leave DATABASE_URL commented out to automatically use canonical SQLite (database_multi_hackathon.sqlite)
#
# LIVE PRODUCTION (PostgreSQL recommended for high-concurrency event rush):
# DATABASE_URL=postgres://idealab_admin:StrongPassword@localhost:5432/idealab_prod
# DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 2. PERSISTENT STORAGE (SUBMISSIONS, CAD FILES, PAYMENT SCREENSHOTS)
# ------------------------------------------------------------------------------
# Default: ./uploads inside project directory.
# For production VPS / institutional server, mount a persistent backup drive:
# UPLOADS_DIR=/var/data/idealab_uploads

# ------------------------------------------------------------------------------
# 3. INSTITUTIONAL EMAIL CONFIGURATION (OFFICE 365 / KCT OUTLOOK)
# ------------------------------------------------------------------------------
# Note: For Microsoft 365 accounts, generate an App Password in your M365 Security Settings.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply.idealab@kct.ac.in
SMTP_PASS=your_m365_app_password_here
MAIL_FROM="AICTE IDEA Lab, KCT" <noreply.idealab@kct.ac.in>

# ------------------------------------------------------------------------------
# 4. HACKATHON & EVENT AUTHORITY LOCKS (CAN ALSO BE TOGGLED FROM ADMIN DASHBOARD)
# ------------------------------------------------------------------------------
# HACKATHON_REGISTRATION_CLOSED=false
# HACKATHON_SUBMISSION_LOCKED=false
# HACKATHON_SHOW_RESULTS=false
