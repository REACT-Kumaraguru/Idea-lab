PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://idea_lab:idea_lab_secret@postgres:5432/idea_lab
SESSION_SECRET=change-this-to-a-long-random-secret

# Microsoft 365 SMTP (create an app password in Microsoft 365 security settings)
