PORT=5001
MYSQL_URI=mysql://user:password@localhost:3306/idea_lab
JWT_SECRET=your_jwt_secret

# Email (Nodemailer) - used for booking and problem statement notifications
# Use a no-reply sender; for Gmail use an App Password: https://support.google.com/accounts/answer/185833
MAIL_FROM="Idea Lab <noreply@yourdomain.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
