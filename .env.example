# Copy to .env and set values when using docker-compose.
# Backend env: see backend/.env.example for full list.

# API URL the frontend (browser) uses. Set when backend is at a different host (e.g. https://api.yourdomain.com).
# Default http://213.210.37.189:5001 when frontend and backend are on the same machine.
# VITE_API_URL=http://213.210.37.189:5001

JWT_SECRET=your_jwt_secret
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
MAIL_FROM="Idea Lab <noreply@yourdomain.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
